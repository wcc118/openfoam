// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     simpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1;

deltaT          1;

writeControl    timeStep;

writeInterval   100;

purgeWrite      0;

writeFormat     ascii;

writePrecision  12;

timeFormat      general;

timePrecision   12;

runTimeModifiable false;

functions
{
    forces
    {
        type            forces;
        libs            ( forces );
        patches         ( wing );
        rho             rhoInf;
        rhoInf          1.22505;
        CofR            ( 0.0254 0 0 );
        p               p;
        U               U;
        writeControl    timeStep;
        writeInterval   1;
    }
    forceCoeffs
    {
        type            forceCoeffs;
        libs            ( forces );
        patches         ( wing );
        rho             rhoInf;
        rhoInf          1.22505;
        CofR            ( 0.0254 0 0 );
        p               p;
        U               U;
        writeControl    timeStep;
        writeInterval   1;
        liftDir         ( -0.0697565 0 0.997564 );
        dragDir         ( 0.997564 0 0.0697565 );
        pitchAxis       ( 0 1 0 );
        magUInf         30;
        lRef            0.1016;
        Aref            0.123871;
    }
    solverInfo
    {
        type            solverInfo;
        libs            ( utilityFunctionObjects );
        fields          ( p U k omega );
        writeControl    timeStep;
        writeInterval   1;
    }
    yPlus
    {
        type            yPlus;
        libs            ( fieldFunctionObjects );
        writeControl    writeTime;
    }
    wallShearStress
    {
        type            wallShearStress;
        libs            ( fieldFunctionObjects );
        patches         ( wing );
        writeControl    writeTime;
    }
}


